[Unit]
Description=DMobileMart FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
User=dmobilemart
Group=dmobilemart
WorkingDirectory=/opt/dmobilemart/current/backend
EnvironmentFile=/etc/dmobilemart/dmobilemart.env
ExecStart=/opt/dmobilemart/current/backend/.venv/bin/gunicorn server:app -k uvicorn.workers.UvicornWorker -w 2 -b 127.0.0.1:8001 --access-logfile - --error-logfile -
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/dmobilemart/uploads

[Install]
WantedBy=multi-user.target